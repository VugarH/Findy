# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://serfeli:serfeli@localhost:5433/serfeli

# Market served by this deployment (see src/config/markets)
MARKET=az

# Secret required by POST /api/cron/daily-deals (Authorization: Bearer <secret>)
CRON_SECRET=change-me

# true = sample stores and prices with a "demo data" banner (for trying the site out). Off unless set to true.
NEXT_PUBLIC_DEMO_DATA=false

# Contact shown to stores in our crawler's User-Agent (an email or URL). Recommended.
BOT_CONTACT=

# Browser push notifications. Generate a key pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a real contact (mailto: or https:) — push services use it to reach you.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public address of the site, for links in Telegram messages (default: https://serfeli.az)
SITE_URL=

# Telegram (optional; see README → Telegram). Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Channel for the daily top deals: @channel_name (the bot must be an admin of the channel)
TELEGRAM_CHANNEL_ID=
# Only for a private channel (numeric id): its invite link
TELEGRAM_CHANNEL_URL=
# Language of the channel posts (az, en or ru); the market's default otherwise
TELEGRAM_CHANNEL_LOCALE=
# Set when Telegram can reach the site (production), then run: npm run telegram -- webhook https://your-site
TELEGRAM_WEBHOOK_SECRET=
